@article{DONG2025103457,
title = {Research on key technology and application progress of rescue robot in nuclear accident emergency situation},
journal = {Nuclear Engineering and Technology},
volume = {57},
number = {6},
pages = {103457},
year = {2025},
issn = {1738-5733},
doi = {https://doi.org/10.1016/j.net.2025.103457},
url = {https://www.sciencedirect.com/science/article/pii/S1738573325000257},
author = {Duo Dong and Ziqi Wang and Jingyu Guan and Yi Xiao and Yuqi Wang},
keywords = {Nuclear accident, Emergency rescue, Robot, Radiation resistance, Rescue strategy},
abstract = {Nuclear energy (NE) is an efficient and clean energy source with strong supply capacity and green environmental protection, which is the guarantee for achieving the “dual carbon” goal. The safe use of NE is the primary task, and the rapid emergency response to nuclear accidents is the pillar of ensuring nuclear safety. Using robots instead of workers into high-risk areas of nuclear accidents to complete on-site reconnaissance, radiation monitoring, cleaning and decontamination, emergency communication, personnel search and other rescue tasks can improve the efficiency of nuclear accident emergency response, reduce economic losses and social negative effects caused by nuclear accidents. With the continuous expansion of NE utilization scale worldwide, nuclear safety assurance is extremely urgent, and the research and development of nuclear accident emergency rescue robots is becoming increasingly important. This paper reviews the research status and development trends of nuclear accident emergency rescue robots, and proposes the key technical parameters of rescue robots, aiming at providing reference for the research and development of nuclear accident emergency rescue robots.}
}

